        # BEGIN GENERATED STRATEGY EXECUTION ADAPTER
        if candidate_side != 0:
            execution_candidate_event_code = 1.0
            execution_candidate_trigger_utc_s = float(candidate_trigger_utc)
            execution_candidate_reason_code = 0.0
            if candidate_blocker == 'INVALID ENTRY OR ATR':
                execution_candidate_reason_code = 10.0
            elif candidate_blocker == 'INVALID STOP':
                execution_candidate_reason_code = 11.0
            elif candidate_blocker == 'STOP > {{stop_cap_atr}} ATR':
                execution_candidate_reason_code = 12.0
            elif candidate_blocker == 'COST > {{cost_r_cap}}R':
                execution_candidate_reason_code = 13.0
            elif position_size != 0:
                execution_candidate_reason_code = 20.0
            elif self._pending is not None or pending_was_resolved:
                execution_candidate_reason_code = 21.0
            elif self.bar_index - self._last_exit_bar <= 3 or self.bar_index - self._last_signal_bar <= 3:
                execution_candidate_reason_code = 22.0
            elif self.trading.cash <= 0.0:
                execution_candidate_reason_code = 23.0
            else:
                tick_size = self.info.tick_size
                if tick_size <= 0.0 or self._quantity_step <= 0.0 or self._minimum_quantity <= 0.0 or self._maximum_market_quantity <= 0.0 or self._minimum_notional_quote <= 0.0:
                    execution_candidate_reason_code = 24.0
                else:
                    planned_entry = candidate_planned_entry
                    raw_limit_quote = planned_entry * (1.0 + {{limit_offset}}) if candidate_side == 1 else planned_entry * (1.0 - {{limit_offset}})
                    order_limit_quote = nan
                    execution_stop = nan
                    execution_target = nan
                    if candidate_side == 1:
                        order_limit_quote = floor(raw_limit_quote / tick_size) * tick_size
                        execution_stop = ceil(candidate_stop / tick_size) * tick_size
                        execution_target = ceil(candidate_target / tick_size) * tick_size
                    else:
                        order_limit_quote = ceil(raw_limit_quote / tick_size) * tick_size
                        execution_stop = floor(candidate_stop / tick_size) * tick_size
                        execution_target = floor(candidate_target / tick_size) * tick_size

                    valid_levels = order_limit_quote > 0.0 and execution_stop > 0.0 and execution_target > 0.0
                    if candidate_side == 1:
                        valid_levels = valid_levels and execution_stop < order_limit_quote and execution_target > order_limit_quote
                    else:
                        valid_levels = valid_levels and execution_stop > order_limit_quote and execution_target < order_limit_quote

                    if not valid_levels:
                        execution_candidate_reason_code = 25.0
                    else:
                        # cost_fraction is the complete non-funding cost scenario, including
                        # the simulator's entry/exit commissions. It is reserved once against
                        # loss sizing; the simulator separately debits its commission cashflows.
                        execution_cost_per_btc = order_limit_quote * self._cost_fraction
                        execution_stop_distance = abs(order_limit_quote - execution_stop)
                        risk_budget = min(self.trading.cash * self._risk_fraction, self._maximum_loss_quote)
                        risk_size = risk_budget / (execution_stop_distance + execution_cost_per_btc)
                        cash_size = self.trading.cash / (order_limit_quote * 1.001)
                        raw_size = min(risk_size, cash_size, self._maximum_market_quantity)
                        if raw_size > 0.0:
                            size = floor(raw_size / self._quantity_step) * self._quantity_step
                            instrument_info = self.trading.instrument_info
                            minimum_quantity = max(instrument_info.min_order_size, self._minimum_quantity)
                            minimum_notional = max(instrument_info.min_order_value, self._minimum_notional_quote)
                            protective_notional = size * min(order_limit_quote, execution_stop, execution_target)
                            modeled_all_in_loss = size * (execution_stop_distance + execution_cost_per_btc)
                            if size < minimum_quantity or protective_notional < minimum_notional:
                                execution_candidate_reason_code = 26.0
                            elif size > self._maximum_market_quantity:
                                execution_candidate_reason_code = 27.0
                            elif modeled_all_in_loss > risk_budget:
                                execution_candidate_reason_code = 28.0
                            else:
                                if candidate_side == 1:
                                    self._pending = (self.trading.place_order(order_side.BUY, size=size)
                                                     .limit(price=order_limit_quote)
                                                     .stop_loss(stop=execution_stop)
                                                     .take_profit(stop=execution_target)
                                                     .submit())
                                else:
                                    self._pending = (self.trading.place_order(order_side.SELL, size=size)
                                                     .limit(price=order_limit_quote)
                                                     .stop_loss(stop=execution_stop)
                                                     .take_profit(stop=execution_target)
                                                     .submit())
                                self._pending_bar = self.bar_index
                                self._cancel_requested = False
                                self._last_signal_bar = self.bar_index
                                execution_candidate_reason_code = 2.0
                        else:
                            execution_candidate_reason_code = 29.0
        # END GENERATED STRATEGY EXECUTION ADAPTER
